# LOCAL DEMO/SMOKE VALUES ONLY. Never rename this file to .env.production.
# Production Compose uses external read-only secrets; see .env.production.example.
BSC_TESTNET_RPC_URL=https://bsc-testnet-dataseed.bnbchain.org
PROTOCOL_MODE=demo
REQUIRE_FILE_SECRETS=false
# Optional local-only host port overrides for shared development machines.
# AGENTGRID_POSTGRES_HOST_PORT=55433
# AGENTGRID_REDIS_HOST_PORT=56380
# AGENTGRID_MINIO_API_HOST_PORT=59000
# AGENTGRID_MINIO_CONSOLE_HOST_PORT=59001
# Optional smoke-test overrides when shared developer services use non-default ports.
# ARTIFACT_KEY_ROTATION_SMOKE_DATABASE_URL=postgresql://agentgrid:password@127.0.0.1:55433/agentgrid
# SECRET_SMOKE_DATABASE_URL=postgresql://agentgrid:password@127.0.0.1:55433/agentgrid
# AGENT_DELIVERY_SMOKE_DATABASE_URL=postgresql://agentgrid:password@127.0.0.1:55433/agentgrid
# AGENT_DELIVERY_SMOKE_REDIS_URL=redis://127.0.0.1:56380/12
# AGENT_DELIVERY_SMOKE_S3_ENDPOINT=http://127.0.0.1:59000
# REORG_SMOKE_DATABASE_URL=postgresql://agentgrid:password@127.0.0.1:55433/agentgrid
# REORG_SMOKE_REDIS_URL=redis://127.0.0.1:56380/13
DATABASE_URL=postgresql://agentgrid:local-agentgrid-password@127.0.0.1:5432/agentgrid
REDIS_URL=redis://127.0.0.1:6379
AGENT_LEASE_SECONDS=60
S3_ENDPOINT=http://127.0.0.1:9000
S3_REGION=us-east-1
S3_BUCKET=agentgrid-artifacts
S3_ACCESS_KEY=agentgrid
S3_SECRET_KEY=local-agentgrid-storage-password
# Set when the Docker daemon cannot bind-mount the host OS temp directory (for example Colima).
# The absolute directory must be mode 0700, non-symlink, and visible to both Worker and Docker daemon.
# SANDBOX_TEMP_DIRECTORY=/absolute/shared/agentgrid-sandbox
ARTIFACT_MASTER_KEY=REPLACE_WITH_64_HEX_CHARACTERS
# Set only during a controlled rotation; comma-separated old 64-hex keys.
# ARTIFACT_PREVIOUS_MASTER_KEYS=OLD_64_HEX_KEY
ADMIN_API_KEY=REPLACE_WITH_AT_LEAST_32_RANDOM_CHARACTERS
ALERT_WEBHOOK_URL=https://alerts.example.com/agentgrid
ALERT_WEBHOOK_SECRET=REPLACE_WITH_AT_LEAST_32_RANDOM_CHARACTERS
DEPLOYMENT_ENVIRONMENT=production
OPS_MONITOR_INTERVAL_SECONDS=60
OPS_MONITOR_REMINDER_SECONDS=900
BACKUP_DIRECTORY=.backups
BACKUP_RETENTION_DAYS=30
# Optional off-host backup target. Use dedicated credentials or workload identity.
# BACKUP_S3_BUCKET=company-agentgrid-backups
# BACKUP_S3_PREFIX=production
# BACKUP_S3_REGION=ap-east-1
# BACKUP_S3_ENDPOINT=https://s3.example.com
# BACKUP_S3_ACCESS_KEY=
# BACKUP_S3_SECRET_KEY=
# BACKUP_S3_KMS_KEY_ID=
AUTH_SECRET=replace-with-at-least-32-random-characters
# Local Demo/smoke origin. Public production must set one exact HTTPS origin
# without a path, query, fragment, or embedded credentials.
AUTH_ORIGIN=http://localhost:3000
TRUST_PROXY=false
BSC_CHAIN_ID=97
CHAIN_CONFIRMATIONS=5
CHAIN_START_BLOCK=0
# WALLETCONNECT_PROJECT_ID=public-project-id-from-walletconnect-cloud
TOKEN_ADDRESS=
STAKE_MANAGER_ADDRESS=
AGENT_REGISTRY_ADDRESS=
TASK_REGISTRY_ADDRESS=
REWARD_VAULT_ADDRESS=
DISPUTE_RESOLVER_ADDRESS=
VERIFICATION_PANEL_ADDRESS=
PROTOCOL_ECONOMICS_ADDRESS=
VERIFICATION_ARBITRATION_COURT_ADDRESS=
DEPLOYER_PRIVATE_KEY=0xREPLACE_WITH_A_TESTNET_ONLY_PRIVATE_KEY
PROTOCOL_RESERVE_ADDRESS=0xOPTIONAL_RESERVE_ADDRESS
PROTOCOL_OWNER_ADDRESS=0xMULTISIG_OR_TIMELOCK_OWNER_ADDRESS
PROTOCOL_COORDINATOR_ADDRESS=0xTESTER_ASSIGNMENT_COORDINATOR_ADDRESS
ARBITRATOR_ADDRESSES=0xARBITRATOR_1,0xARBITRATOR_2,0xARBITRATOR_3
ARBITRATOR_QUORUM=2
PROTOCOL_OPERATOR_PRIVATE_KEY=0xREPLACE_WITH_A_TESTNET_ONLY_OPERATOR_PRIVATE_KEY
PROTOCOL_URL=http://localhost:3000
AGENT_ID=agent-builder-01
AGENT_API_KEY=amp_demo_executor
AGENT_QUEUE_MODE=false
AGENT_WALLET_PRIVATE_KEY=0xREPLACE_WITH_THE_AGENT_TESTNET_ONLY_PRIVATE_KEY
AI_BASE_URL=https://api.openai.com/v1
# Required when AGENT_QUEUE_MODE=true. Exact comma-separated AI provider origins
# whose data-processing terms the Agent operator has approved.
AI_ALLOWED_ORIGINS=https://api.openai.com
AI_API_KEY=
AI_MODEL=
# Optional OpenAI-compatible models used by the Web requirement-clarification gate.
# Use 2-3 different models for writer, validation critic, and domain reviewer roles.
SPEC_ASSISTANT_AI_BASE_URL=https://api.openai.com/v1
SPEC_ASSISTANT_AI_ALLOWED_ORIGINS=https://api.openai.com
SPEC_ASSISTANT_AI_MODELS=
SPEC_ASSISTANT_AI_API_KEY=
