# Non-secret production configuration only. Copy to .env.production, fill the
# addresses/URLs, and provision every external secret named below through the
# deployment platform. Never put private keys, database passwords, API keys, or
# master keys in this file.
BSC_TESTNET_RPC_URL=https://bsc-testnet-dataseed.bnbchain.org
BSC_CHAIN_ID=97
CHAIN_CONFIRMATIONS=5
CHAIN_START_BLOCK=0
# WALLETCONNECT_PROJECT_ID=public-project-id-from-walletconnect-cloud
AUTH_ORIGIN=https://agentgrid.example.com
TRUST_PROXY=false
# Set true only after the edge strips client-supplied X-Forwarded-For,
# X-Real-IP and X-AgentGrid-Proxy-Auth, replaces X-Forwarded-For with one
# canonical client IP, and injects the file-backed proxy secret.
S3_REGION=us-east-1
S3_BUCKET=agentgrid-artifacts
ALERT_WEBHOOK_URL=https://alerts.example.com/agentgrid
DEPLOYMENT_ENVIRONMENT=production
OPS_MONITOR_INTERVAL_SECONDS=60
OPS_MONITOR_REMINDER_SECONDS=900
# Alert receivers must verify HMAC and return the documented acknowledgement.
# Production drill-only values (set in a secure one-shot job, not the long-lived stack):
# MONITORING_ALERT_TARGET_CLASS=production-https
# MONITORING_ALERT_RECEIVER_PROVIDER=your-pager-or-incident-provider
# MONITORING_ALERT_DRILL_REMINDER_DELAY_MS=30000
# MONITORING_ALERT_DRILL_REPORT_FILE=/secure/release-evidence/operations/monitoring-alert-drill.json
# MONITORING_EVIDENCE_CANDIDATE_BUILD_ID=<exact-final-build-id>
# MONITORING_EVIDENCE_DEPLOYMENT_MANIFEST_SHA256=sha256:<exact-deployment-manifest-hash>
# One-shot external edge evidence (not long-lived service configuration):
# EDGE_EVIDENCE_TARGET_CLASS=production-edge
# EDGE_EVIDENCE_VANTAGE_CLASS=external-independent
# EDGE_PROVIDER=<cdn-waf-provider>
# EDGE_PUBLIC_ORIGIN=https://agentgrid.example.com
# EDGE_HTTP_ORIGIN=http://agentgrid.example.com
# EDGE_DIRECT_ORIGIN=http://origin-address-not-routed-through-edge
# EDGE_MARKER_HEADER=x-agentgrid-edge
# EDGE_MARKER_VALUE=<public-edge-marker>
# EDGE_WAF_BODY_BYTES=12582912
# EDGE_WAF_RATE_LIMIT_ATTEMPTS=20
# EDGE_EVIDENCE_CANDIDATE_BUILD_ID=<exact-final-build-id>
# EDGE_EVIDENCE_DEPLOYMENT_MANIFEST_SHA256=sha256:<exact-deployment-manifest-hash>
# EDGE_SECURITY_REPORT_FILE=/secure/release-evidence/operations/tls-waf-trusted-proxy.json
# One-shot KMS custody/recovery evidence (isolated recovery job only):
# KMS_PROVIDER_OBSERVATION_FILE=/secure/read-only/kms-provider-observation.json
# KMS_RECOVERY_SECRET_ROOT=/run/recovered-secrets
# KMS_EVIDENCE_CANDIDATE_BUILD_ID=<exact-final-build-id>
# KMS_EVIDENCE_DEPLOYMENT_MANIFEST_SHA256=sha256:<exact-deployment-manifest-hash>
# KMS_CUSTODY_REPORT_FILE=/secure/release-evidence/security/kms-custody-recovery.json
# KMS_RECOVERY_EPHEMERAL_JOB=true
# KMS_RECOVERY_ORIGINAL_RUNTIME_DISABLED=true
# KMS_RECOVERY_MOUNTS_SCOPED_TO_JOB=true
BACKUP_RETENTION_DAYS=30
# A public launch requires an encrypted off-host target and a restore drill.
BACKUP_S3_BUCKET=
BACKUP_S3_PREFIX=agentgrid-backups
BACKUP_S3_REGION=ap-east-1
# Leave empty for AWS S3; custom endpoints must use HTTPS in production.
BACKUP_S3_ENDPOINT=
BACKUP_S3_KMS_KEY_ID=
TOKEN_ADDRESS=
STAKE_MANAGER_ADDRESS=
AGENT_REGISTRY_ADDRESS=
TASK_REGISTRY_ADDRESS=
REWARD_VAULT_ADDRESS=
DISPUTE_RESOLVER_ADDRESS=
PROTOCOL_RESERVE_ADDRESS=
PROTOCOL_OWNER_ADDRESS=
PROTOCOL_COORDINATOR_ADDRESS=
ARBITRATOR_ADDRESSES=
ARBITRATOR_QUORUM=2
EVALUATOR_AGENT_ID=
# Optional multi-model requirement clarification. If configured, mount the API
# key as a read-only file and allowlist the exact provider origin.
SPEC_ASSISTANT_AI_BASE_URL=https://api.openai.com/v1
SPEC_ASSISTANT_AI_ALLOWED_ORIGINS=https://api.openai.com
SPEC_ASSISTANT_AI_MODELS=
# SPEC_ASSISTANT_AI_API_KEY_FILE=/run/secrets/spec_assistant_ai_api_key

# Final launch evidence is public metadata/signatures, not a secret. Keep the
# evidence tree outside the source checkout and mount/read it as immutable data.
# PRODUCTION_RELEASE_EVIDENCE_ROOT=/absolute/read-only/path/release-evidence
# PRODUCTION_RELEASE_EVIDENCE_FILE=/absolute/read-only/path/production-release-bundle.json
# APPLICATION_QA_REPORT_FILE=/absolute/path/outside/source/application-qa.json
# PILOT_DEPLOYMENT_FILE=/absolute/read-only/path/release-evidence/chain/bsc-testnet.json
# PILOT_SIGNOFF_FILE=/absolute/read-only/path/release-evidence/pilot/pilot-signoff-bundle.json

# Override these names only when the deployment platform uses a different
# external-secret naming convention.
AGENTGRID_DATABASE_URL_SECRET=agentgrid_database_url
AGENTGRID_POSTGRES_PASSWORD_SECRET=agentgrid_postgres_password
AGENTGRID_AUTH_SECRET=agentgrid_auth_secret
AGENTGRID_S3_ACCESS_KEY_SECRET=agentgrid_s3_access_key
AGENTGRID_S3_SECRET_KEY_SECRET=agentgrid_s3_secret_key
AGENTGRID_ARTIFACT_MASTER_KEY_SECRET=agentgrid_artifact_master_key
AGENTGRID_ADMIN_API_KEY_SECRET=agentgrid_admin_api_key
AGENTGRID_ALERT_WEBHOOK_SECRET=agentgrid_alert_webhook_secret
AGENTGRID_TRUSTED_PROXY_SHARED_SECRET=agentgrid_trusted_proxy_shared_secret
AGENTGRID_PROTOCOL_OPERATOR_PRIVATE_KEY_SECRET=agentgrid_protocol_operator_private_key
AGENTGRID_EVALUATOR_AGENT_API_KEY_SECRET=agentgrid_evaluator_agent_api_key
AGENTGRID_EVALUATOR_AGENT_WALLET_PRIVATE_KEY_SECRET=agentgrid_evaluator_agent_wallet_private_key
AGENTGRID_BACKUP_S3_ACCESS_KEY_SECRET=agentgrid_backup_s3_access_key
AGENTGRID_BACKUP_S3_SECRET_KEY_SECRET=agentgrid_backup_s3_secret_key
AGENTGRID_SPEC_ASSISTANT_AI_API_KEY_SECRET=agentgrid_spec_assistant_ai_api_key

# Deployment CLI secrets are file-backed outside Compose as well.
# DEPLOYER_PRIVATE_KEY_FILE=/absolute/read-only/path/deployer-private-key
# PILOT_PUBLISHER_PRIVATE_KEY_FILE=/absolute/read-only/path/pilot-publisher-key
# PILOT_EVALUATOR_1_PRIVATE_KEY_FILE=/absolute/read-only/path/pilot-evaluator-1-key
# PILOT_EVALUATOR_2_PRIVATE_KEY_FILE=/absolute/read-only/path/pilot-evaluator-2-key
# PILOT_EVALUATOR_3_PRIVATE_KEY_FILE=/absolute/read-only/path/pilot-evaluator-3-key
# PILOT_EXECUTOR_PRIVATE_KEY_FILE=/absolute/read-only/path/pilot-executor-key
# PILOT_TESTER_PRIVATE_KEY_FILE=/absolute/read-only/path/pilot-tester-key
# PILOT_RUN_FILE=/absolute/path/inside/contracts/pilot-runs/existing-run.json
# BACKUP_S3_ACCESS_KEY_FILE=/absolute/read-only/path/backup-access-key
# BACKUP_S3_SECRET_KEY_FILE=/absolute/read-only/path/backup-secret-key
